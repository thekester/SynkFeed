POSTGRES_DB=synkfeed
POSTGRES_USER=synkfeed
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://synkfeed:replace-with-a-long-random-password@postgres:5432/synkfeed
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
RSS_FETCH_INTERVAL_SECONDS=900
RSS_MAX_RESPONSE_SIZE=5242880
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=
